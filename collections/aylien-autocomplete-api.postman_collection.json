        {
          "id": "52e40431-5e0d-488b-ba66-1f2c18d53c4e",
          "name": "List autocompletes",
          "request": {
            "name": "List autocompletes",
            "description": {
              "content": "The autocompletes endpoint a string of characters provided to it, and then returns suggested terms that are the most likely full words or strings. The terms returned by the News API are based on parameters the type parameters you can see below. For example, if you provide the autocompletes endpoint with the term `New York C` and select the type `dbpedia_resources`, the API will return links to the DBpedia resources `New_York_City`, `New_York_City_Subway`, `New_York_City_Police_Department`, and so on.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "autocompletes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) This parameter is used for defining the type of autocompletes.\n"
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) This parameter is used for finding autocomplete objects that contain the specified value.\n"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "en",
                  "description": "This parameter is used for autocompletes whose language is the specified value. It supports [ISO 639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) language codes.\n"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "3",
                  "description": "This parameter is used for specifying number of items in each page.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-AYLIEN-NewsAPI-Application-ID"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
